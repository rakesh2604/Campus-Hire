# Environment Variables for Backend

# Server
NODE_ENV=development
PORT=3000

# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/campushire?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Email (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key_here
EMAIL_FROM=noreply@campushire.com

# AI Provider (gemini, openai, or claude)
# Gemini is recommended - FREE tier available!
AI_PROVIDER=gemini

# Google Gemini (Default - FREE Tier Available!)
GEMINI_API_KEY=your_gemini_api_key_here
# Leave GEMINI_MODEL empty to use default (gemini-pro), or set to: gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=

# OpenAI (Requires Credits)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Claude (Requires Credits)
CLAUDE_API_KEY=your_claude_api_key_here

# Frontend URL
FRONTEND_URL=http://localhost:5173

